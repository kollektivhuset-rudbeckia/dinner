# Copy to .env and fill in. Never commit the real .env.

# Want to look around first? You do not need this file at all — see "Prova på"
# in the README, or just run:  docker compose -f docker-compose.demo.yml up

# --- Required ---------------------------------------------------------------

# The one password everyone in the house shares. Anything except the guest page
# is locked behind it.
DINNER_PASSWORD=byt-mig-till-nagot-langt

# The public address. It is used in the link mailed to the cooking team, so it
# has to be the real one or that link goes nowhere.
BASE_URL=https://middag.rudbeckia.nu

# --- Optional ---------------------------------------------------------------

# A second password that also unlocks /admin, where matlag, säsonger, uppehåll
# and schemat are managed. Leave empty to turn the admin view off entirely.
ADMIN_PASSWORD=

# Signs session cookies, the remembered identity and the links mailed to the
# cooking teams. If empty it is derived from the passwords above, which means
# changing a password logs everyone out and voids the mailed links. Set it to
# keep them working.
SESSION_SECRET=

# How long a login lasts.
SESSION_DAYS=90

# debug, info, warn or error.
LOG_LEVEL=info

# --- Outgoing mail ----------------------------------------------------------
# Leave SMTP_HOST empty to run without e-mail: registration still works and the
# list is still on the site, but the cooking team is not told when it is ready.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=middag@rudbeckia.nu
SMTP_FROM_NAME=Rudbeckia middagar
# starttls (port 587), tls (port 465) or none.
SMTP_ENCRYPTION=starttls
# Where replies from a cooking-team leader go.
SMTP_REPLY_TO=
# Optional blind copy of every notification, e.g. the matgrupp's address.
SMTP_BCC=
