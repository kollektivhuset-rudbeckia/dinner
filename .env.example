# Copy to .env and fill in. Never commit the real .env.

# Want to look around first? You do not need this file at all — see "Prova på"
# in the README, or just run:  docker compose -f docker-compose.demo.yml up

# --- Required ---------------------------------------------------------------

# The one password everyone in the house shares. Anything except the guest page
# is locked behind it.
DINNER_PASSWORD=byt-mig-till-nagot-langt

# The public address. It is used in the links the bot sends out — the cooking
# team's list, and a household's own registration — so it has to be the real
# one or those links go nowhere.
BASE_URL=https://dinner.rudbeckia.nu

# --- Optional ---------------------------------------------------------------

# A second password that also unlocks /admin, where matlag, säsonger, uppehåll
# and schemat are managed. Leave empty to turn the admin view off entirely.
ADMIN_PASSWORD=

# Signs session cookies, the remembered identity and the links sent to the
# cooking teams. If empty it is derived from the passwords above, which means
# changing a password logs everyone out and voids the links already sent. Set
# it to keep them working.
SESSION_SECRET=

# How long a login lasts.
SESSION_DAYS=90

# debug, info, warn or error.
LOG_LEVEL=info

# --- Mattermost -------------------------------------------------------------
# The bot that confirms a household's registration, sends the list to the
# cooking team's leader, and answers the pages' lookups of who is in the house.
# Leave both empty to run without a chat server: registration still works, the
# evening can still be put in a calendar from the page and the list is still on
# the site, but nobody is told anything — the messages are written to the log.
# Set both or neither — half a configuration is refused at startup.

MATTERMOST_URL=https://chat.rudbeckia.nu
MATTERMOST_TOKEN=
